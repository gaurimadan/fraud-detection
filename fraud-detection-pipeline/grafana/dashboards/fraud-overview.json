{
  "id": null,
  "uid": "fraud-overview",
  "title": "Real-Time Fraud Detection",
  "tags": ["fraud", "transactions"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Transactions per minute",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "fraud-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(event_time, '1m') AS time, COUNT(*) AS transactions FROM transactions WHERE model_version = 'paysim-gradient-boosting-v3' AND $__timeFilter(event_time) GROUP BY 1 ORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "title": "ML fraud risk",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "fraud-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT event_time AS time, fraud_probability * 100 AS risk_percent FROM transactions WHERE model_version = 'paysim-gradient-boosting-v3' AND is_fraud_predicted AND $__timeFilter(event_time) ORDER BY event_time",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "ML fraud predictions per hour",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "fraud-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(window_start, '1h') AS time, COUNT(*) AS predictions FROM fraud_alerts WHERE alert_type = 'ml_fraud_prediction' AND details->>'model_version' = 'paysim-gradient-boosting-v3' AND $__timeFilter(window_start) GROUP BY 1 ORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "title": "Recent ML fraud predictions",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "fraud-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT window_start AS time, customer_id, details->>'fraud_probability' AS fraud_probability, details->>'prediction_threshold' AS prediction_threshold, details->>'model_version' AS model_version FROM fraud_alerts WHERE alert_type = 'ml_fraud_prediction' AND details->>'model_version' = 'paysim-gradient-boosting-v3' AND $__timeFilter(window_start) ORDER BY window_start DESC LIMIT 100",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "time",
            "desc": true
          }
        ]
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "links": []
}
