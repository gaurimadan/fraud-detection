{
  "id": null,
  "uid": "fraud-overview",
  "title": "Real-Time Fraud Detection",
  "tags": ["fraud", "transactions"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Transactions per minute",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "fraud-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(event_time, '1m') AS time, COUNT(*) AS transactions FROM transactions WHERE $__timeFilter(event_time) GROUP BY 1 ORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "title": "High-value transactions",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "fraud-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT event_time AS time, amount FROM transactions WHERE is_high_amount AND $__timeFilter(event_time) ORDER BY event_time",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "Fraud alerts by type",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "fraud-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT alert_type, COUNT(*) AS alerts FROM fraud_alerts WHERE $__timeFilter(window_start) GROUP BY alert_type ORDER BY alerts DESC",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "title": "Recent fraud alerts",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "fraud-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT window_start AS time, alert_type, customer_id, metric_value, details::text AS details FROM fraud_alerts WHERE $__timeFilter(window_start) ORDER BY window_start DESC LIMIT 100",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "time",
            "desc": true
          }
        ]
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "links": []
}
